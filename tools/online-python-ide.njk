{% include "python-tool-runner.njk" %}
<script>
    document.addEventListener('DOMContentLoaded', () => {
        window.initPythonTool('editor', 'output', 'run-btn', 'reset-btn', 'status-badge');

        const workspace = document.getElementById('ide-workspace');
        const editorPane = document.getElementById('ide-editor-pane');
        const terminalPane = document.getElementById('ide-terminal-pane');
        const resizer = document.getElementById('ide-resizer');
        const editor = document.getElementById('editor');
        const cursorPosition = document.getElementById('cursor-position');
        const desktopQuery = window.matchMedia('(min-width: 768px)');

        if (!workspace || !editorPane || !terminalPane || !resizer || !editor) {
            return;
        }

        const MIN_EDITOR_WIDTH = 340;
        const MIN_TERMINAL_WIDTH = 390;
        const TERMINAL_MAX_REDUCTION_FACTOR = 0.7;
        let isDragging = false;
        let hasCustomWidth = false;
        let startX = 0;
        let startEditorWidth = 0;

        function setMobileLayout() {
            editorPane.style.flex = '';
            terminalPane.style.flex = '';
        }

        function getTerminalBounds(totalWidth) {
            const hardMaxTerminal = Math.max(0, totalWidth - MIN_EDITOR_WIDTH);

            if (hardMaxTerminal <= 0) {
                return { min: 0, max: 0 };
            }

            const minTerminal = Math.min(MIN_TERMINAL_WIDTH, hardMaxTerminal);
            const reducedMaxTerminal = hardMaxTerminal * TERMINAL_MAX_REDUCTION_FACTOR;
            const maxTerminal = Math.max(minTerminal, Math.min(hardMaxTerminal, reducedMaxTerminal));

            return { min: minTerminal, max: maxTerminal };
        }

        function getDefaultEditorWidth(totalWidth) {
            const terminalBounds = getTerminalBounds(totalWidth);
            const defaultTerminalWidth = (terminalBounds.min + terminalBounds.max) / 2;
            return totalWidth - defaultTerminalWidth;
        }

        function setEditorWidth(rawWidth) {
            const totalWidth = workspace.getBoundingClientRect().width;
            if (totalWidth <= 0) {
                return;
            }

            const terminalBounds = getTerminalBounds(totalWidth);
            const rawTerminalWidth = totalWidth - rawWidth;
            const clampedTerminalWidth = Math.min(
                terminalBounds.max,
                Math.max(terminalBounds.min, rawTerminalWidth)
            );
            const clampedEditorWidth = totalWidth - clampedTerminalWidth;

            editorPane.style.flex = `0 0 ${clampedEditorWidth}px`;
            terminalPane.style.flex = `0 0 ${clampedTerminalWidth}px`;
        }

        function syncDesktopLayout() {
            if (!desktopQuery.matches) {
                setMobileLayout();
                return;
            }

            const totalWidth = workspace.getBoundingClientRect().width;
            if (totalWidth <= 0) {
                return;
            }

            const desiredWidth = hasCustomWidth
                ? editorPane.getBoundingClientRect().width
                : getDefaultEditorWidth(totalWidth);

            setEditorWidth(desiredWidth);
        }

        function getCaretOffset(container) {
            const selection = window.getSelection();
            if (!selection || selection.rangeCount === 0) {
                return null;
            }

            const range = selection.getRangeAt(0);
            if (!container.contains(range.endContainer)) {
                return null;
            }

            const preCaretRange = range.cloneRange();
            preCaretRange.selectNodeContents(container);
            preCaretRange.setEnd(range.endContainer, range.endOffset);
            return preCaretRange.toString().length;
        }

        function updateCursorPosition() {
            if (!cursorPosition) {
                return;
            }

            const offset = getCaretOffset(editor);
            if (offset === null) {
                return;
            }

            const source = editor.textContent || '';
            const safeOffset = Math.max(0, Math.min(offset, source.length));
            const beforeCaret = source.slice(0, safeOffset);
            const line = beforeCaret.split('\n').length;
            const lastNewline = beforeCaret.lastIndexOf('\n');
            const column = beforeCaret.length - lastNewline;
            cursorPosition.textContent = `Ln ${line}, Col ${column}`;
        }

        function stopResize() {
            if (!isDragging) {
                return;
            }

            isDragging = false;
            document.body.style.userSelect = '';
            document.body.style.cursor = '';
        }

        resizer.addEventListener('pointerdown', (event) => {
            if (!desktopQuery.matches) {
                return;
            }

            event.preventDefault();
            isDragging = true;
            hasCustomWidth = true;
            startX = event.clientX;
            startEditorWidth = editorPane.getBoundingClientRect().width;

            document.body.style.userSelect = 'none';
            document.body.style.cursor = 'col-resize';

            if (resizer.setPointerCapture) {
                resizer.setPointerCapture(event.pointerId);
            }
        });

        resizer.addEventListener('pointermove', (event) => {
            if (!isDragging || !desktopQuery.matches) {
                return;
            }

            const delta = event.clientX - startX;
            setEditorWidth(startEditorWidth + delta);
        });

        resizer.addEventListener('pointerup', stopResize);
        resizer.addEventListener('pointercancel', stopResize);
        resizer.addEventListener('lostpointercapture', stopResize);
        window.addEventListener('resize', syncDesktopLayout);

        if (desktopQuery.addEventListener) {
            desktopQuery.addEventListener('change', syncDesktopLayout);
        } else if (desktopQuery.addListener) {
            desktopQuery.addListener(syncDesktopLayout);
        }

        editor.addEventListener('keyup', updateCursorPosition);
        editor.addEventListener('click', updateCursorPosition);
        editor.addEventListener('input', () => {
            requestAnimationFrame(updateCursorPosition);
        });
        document.addEventListener('selectionchange', () => {
            const selection = window.getSelection();
            if (selection && selection.rangeCount > 0 && editor.contains(selection.anchorNode)) {
                updateCursorPosition();
            }
        });

        syncDesktopLayout();
        requestAnimationFrame(updateCursorPosition);
    });
</script>
