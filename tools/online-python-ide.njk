<div class="h-full flex flex-col bg-[#0f172a] text-[#e2e8f0]">
    <div class="flex-1 flex flex-col md:flex-row min-h-0">
        <!-- Editor Pane -->
        <div id="ide-editor-pane" class="flex flex-col flex-1 min-w-0 md:w-[55%]">
            <div class="h-10 shrink-0 flex items-center justify-between border-b border-[#334155] bg-[#1e293b] px-3">
                <div class="flex items-center gap-2 text-sm">
                    <i class="fa-brands fa-python text-yellow-400" aria-hidden="true"></i>
                    <span class="text-slate-300 font-medium">main.py</span>
                    <span id="save-indicator" class="text-[10px] text-slate-500 hidden">saved</span>
                </div>
                <div class="flex items-center gap-2">
                    <span id="status-badge" class="text-xs text-slate-400">Ready</span>
                    <button
                        id="clear-btn"
                        type="button"
                        class="inline-flex items-center gap-1 justify-center rounded-md border border-slate-600 px-2 py-1 text-[11px] text-slate-400 transition-colors hover:border-slate-400 hover:text-white"
                        title="Clear output (Ctrl+L)"
                        aria-label="Clear output">
                        <i class="fa-solid fa-broom text-[10px]" aria-hidden="true"></i>
                        <span>Clear</span>
                    </button>
                    <button
                        id="reset-btn"
                        type="button"
                        class="inline-flex items-center gap-1 justify-center rounded-md border border-slate-600 px-2 py-1 text-[11px] text-slate-400 transition-colors hover:border-slate-400 hover:text-white"
                        title="Reset editor content"
                        aria-label="Reset editor content">
                        <i class="fa-solid fa-rotate-left text-[10px]" aria-hidden="true"></i>
                        <span>Reset</span>
                    </button>
                    <button id="run-btn" class="inline-flex items-center gap-1.5 rounded-md bg-green-600 px-3 py-1 text-xs font-semibold text-white transition-colors hover:bg-green-500 shadow-sm">
                        <svg class="h-3 w-3" fill="currentColor" viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg>
                        <span>Run</span>
                    </button>
                </div>
            </div>
            <pre class="flex-1 min-h-0 language-python rounded-none m-0"><code id="editor" class="language-python block h-full focus:outline-none p-4 rounded-none" contenteditable="true" spellcheck="false"># Python Online IDE
# Press Ctrl+Enter (Cmd+Enter on Mac) to run

class User:
    def __init__(self, name, role):
        self.name = name
        self.role = role

    def describe(self):
        return f"{self.name} is a {self.role}"

admin = User("Admin", "Superuser")
guest = User("Guest", "Visitor")

print(admin.describe())
print(guest.describe())
</code></pre>
        </div>

        <!-- Resizer -->
        <div
            id="ide-resizer"
            class="hidden md:flex w-1.5 shrink-0 cursor-col-resize items-center justify-center bg-[#1e293b] border-x border-[#334155] transition-colors hover:bg-blue-600 active:bg-blue-700"
            role="separator"
            aria-orientation="vertical"
            aria-label="Resize editor and output panes">
            <span class="h-10 w-[2px] rounded-full bg-slate-500/50"></span>
        </div>

        <!-- Output / Terminal Pane -->
        <div id="ide-terminal-pane" class="h-48 md:h-auto md:w-[45%] flex flex-col bg-[#0f172a] border-t md:border-t-0 border-[#334155]">
            <!-- Tab bar -->
            <div class="h-10 flex items-center justify-between px-2 bg-[#1e293b] text-xs border-b border-[#334155]">
                <div class="flex items-center">
                    <button id="tab-output" class="px-3 py-2 text-white border-b-2 border-blue-500 font-medium transition-colors">Output</button>
                    <button id="tab-terminal" class="px-3 py-2 text-slate-400 border-b-2 border-transparent hover:text-slate-200 transition-colors">Terminal</button>
                </div>
                <div class="flex items-center gap-2 pr-2">
                    <button id="clear-terminal-btn" class="hidden inline-flex items-center gap-1 justify-center rounded-md border border-slate-600 px-2 py-1 text-[11px] text-slate-400 transition-colors hover:border-slate-400 hover:text-white" title="Clear terminal">
                        <i class="fa-solid fa-broom text-[10px]" aria-hidden="true"></i>
                        <span>Clear</span>
                    </button>
                    <span id="cursor-position" class="text-slate-500 font-mono">Ln 1, Col 1</span>
                </div>
            </div>
            <!-- Output content -->
            <div id="output" class="flex-1 p-4 font-mono text-sm text-[#e2e8f0] overflow-auto whitespace-pre-wrap"></div>
            <!-- Terminal content -->
            <div id="terminal" class="flex-1 flex flex-col overflow-hidden hidden">
                <div id="terminal-history" class="flex-1 p-4 font-mono text-sm text-[#e2e8f0] overflow-auto whitespace-pre-wrap"></div>
                <div class="shrink-0 flex items-center px-4 py-2 bg-[#0a0f1a] border-t border-[#334155] font-mono text-sm">
