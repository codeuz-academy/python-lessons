            </div>
        </div>
    </div>

    <!-- Status Bar -->
    <div class="h-7 bg-[#1e293b] text-slate-400 flex items-center px-4 text-[11px] justify-between shrink-0 border-t border-[#334155]">
        <div class="flex items-center gap-4">
            <span>Python 3.12 (Pyodide)</span>
            <span class="text-slate-500">Ctrl+Enter to run</span>
        </div>
        <div class="flex items-center gap-4">
            <span>UTF-8</span>
        </div>
    </div>
</div>

{% include "python-tool-runner.njk" %}
<script>
    document.addEventListener('DOMContentLoaded', () => {
        window.initPythonTool('editor', 'output', 'run-btn', 'reset-btn', 'status-badge');

        const workspace = document.querySelector('#ide-editor-pane').parentElement;
        const editorPane = document.getElementById('ide-editor-pane');
        const terminalPane = document.getElementById('ide-terminal-pane');
        const resizer = document.getElementById('ide-resizer');
        const editor = document.getElementById('editor');
        const cursorPosition = document.getElementById('cursor-position');
        const clearBtn = document.getElementById('clear-btn');
        const output = document.getElementById('output');
        const saveIndicator = document.getElementById('save-indicator');
        const desktopQuery = window.matchMedia('(min-width: 768px)');
        const STORAGE_KEY = 'python-ide-code';

        // --- Tabs ---
        const tabOutput = document.getElementById('tab-output');
        const tabTerminal = document.getElementById('tab-terminal');
        const terminalEl = document.getElementById('terminal');
        const terminalHistory = document.getElementById('terminal-history');
        const terminalInput = document.getElementById('terminal-input');
        const clearTerminalBtn = document.getElementById('clear-terminal-btn');

        function switchTab(tab) {
            if (tab === 'output') {
                output.classList.remove('hidden');
                terminalEl.classList.add('hidden');
                tabOutput.classList.add('text-white', 'border-blue-500');
                tabOutput.classList.remove('text-slate-400', 'border-transparent');
                tabTerminal.classList.remove('text-white', 'border-blue-500');
                tabTerminal.classList.add('text-slate-400', 'border-transparent');
                clearTerminalBtn.classList.add('hidden');
            } else {
                output.classList.add('hidden');
                terminalEl.classList.remove('hidden');
                tabTerminal.classList.add('text-white', 'border-blue-500');
                tabTerminal.classList.remove('text-slate-400', 'border-transparent');
                tabOutput.classList.remove('text-white', 'border-blue-500');
                tabOutput.classList.add('text-slate-400', 'border-transparent');
                clearTerminalBtn.classList.remove('hidden');
                terminalInput.focus();
                initRepl();
            }
        }

        clearTerminalBtn.addEventListener('click', () => {
            terminalHistory.innerHTML = '';
        });

        tabOutput.addEventListener('click', () => switchTab('output'));
        tabTerminal.addEventListener('click', () => switchTab('terminal'));

        // Switch to output tab when Run is clicked
        document.getElementById('run-btn').addEventListener('click', () => switchTab('output'));

        // --- REPL ---
        let replReady = false;
        let replBusy = false;
        const replCommandHistory = [];
        let replHistoryIdx = -1;

        function appendToHistory(html) {
            terminalHistory.insertAdjacentHTML('beforeend', html);
            terminalHistory.scrollTop = terminalHistory.scrollHeight;
        }

        async function initRepl() {
            if (replReady) return;
            replReady = true;
            appendToHistory('<span class="text-slate-500">Initializing Python REPL...</span>\n');

            try {
                await window.PyRuntime.run('pass', { timeoutMs: 30000, useWorker: false });
                appendToHistory('<span class="text-green-400">Python 3.12 (Pyodide)\nType Python expressions and press Enter.\n</span>\n');
            } catch (err) {
                appendToHistory('<span class="text-red-400">Failed to initialize: ' + err.message + '</span>\n');
                replReady = false;
            }
        }

        async function executeRepl(code) {
            if (replBusy || !code.trim()) return;
            replBusy = true;

            appendToHistory('<span class="text-green-400">&gt;&gt;&gt; </span>' + escapeHtml(code) + '\n');
            terminalInput.value = '';

            try {
                const wrappedCode =
                    'import sys as __sys__\n' +
                    'import io as __io__\n' +
                    '__out__=__io__.StringIO()\n' +
                    '__err__=__io__.StringIO()\n' +
                    '__sys__.stdout=__out__\n' +
                    '__sys__.stderr=__err__\n' +
                    'try:\n' +
                    '    try:\n' +
                    '        __val__=eval(' + JSON.stringify(code) + ')\n' +
                    '        if __val__ is not None:print(repr(__val__))\n' +
                    '    except SyntaxError:\n' +
                    '        exec(' + JSON.stringify(code) + ')\n' +
                    'except Exception as __e__:\n' +
                    '    print(type(__e__).__name__+": "+str(__e__),file=__err__)\n' +
                    'finally:\n' +
                    '    __sys__.stdout=__sys__.__stdout__\n' +
                    '    __sys__.stderr=__sys__.__stderr__\n' +
                    '__stdout_val__=__out__.getvalue()\n' +
                    '__stderr_val__=__err__.getvalue()\n';

                const result = await window.PyRuntime.run(wrappedCode, {
                    timeoutMs: 30000,
                    useWorker: false
                });

                const getOutput = await window.PyRuntime.run(
                    'print(__stdout_val__, end="")',
                    { timeoutMs: 5000, useWorker: false }
                );
                const getErrors = await window.PyRuntime.run(
                    'print(__stderr_val__, end="")',
                    { timeoutMs: 5000, useWorker: false }
                );

                if (getOutput.stdout) {
                    appendToHistory(escapeHtml(getOutput.stdout) + '\n');
                }
                if (getErrors.stdout) {
                    appendToHistory('<span class="text-red-400">' + escapeHtml(getErrors.stdout) + '</span>\n');
                }
            } catch (err) {
                appendToHistory('<span class="text-red-400">' + escapeHtml(err.message) + '</span>\n');
            } finally {
                replBusy = false;
            }
        }

        function escapeHtml(str) {
            return str.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
        }

        terminalInput.addEventListener('keydown', (e) => {
            if (e.key === 'Enter' && !e.shiftKey) {
                e.preventDefault();
                const code = terminalInput.value;
                if (code.trim()) {
                    replCommandHistory.push(code);
                    replHistoryIdx = replCommandHistory.length;
                }
                executeRepl(code);
            }
            if (e.key === 'ArrowUp') {
                e.preventDefault();
                if (replHistoryIdx > 0) {
                    replHistoryIdx--;
                    terminalInput.value = replCommandHistory[replHistoryIdx] || '';
                }
            }
            if (e.key === 'ArrowDown') {
                e.preventDefault();
                if (replHistoryIdx < replCommandHistory.length - 1) {
                    replHistoryIdx++;
                    terminalInput.value = replCommandHistory[replHistoryIdx] || '';
                } else {
                    replHistoryIdx = replCommandHistory.length;
                    terminalInput.value = '';
                }
            }
        });

        if (!workspace || !editorPane || !terminalPane || !resizer || !editor) return;

        // --- Auto-save ---
        const saved = localStorage.getItem(STORAGE_KEY);
        if (saved !== null && saved.trim() !== '') {
            editor.textContent = saved;
            if (window.EditorHelpers) {
                const parsed = window.EditorHelpers.parseEditorClass(editor);
                window.EditorHelpers.renderHighlightedEditable(editor, parsed.language, parsed.baseClassName);
            }
        }

        let saveTimeout = null;
        function scheduleAutoSave() {
            clearTimeout(saveTimeout);
            saveTimeout = setTimeout(() => {
                localStorage.setItem(STORAGE_KEY, editor.textContent || '');
                if (saveIndicator) {
                    saveIndicator.classList.remove('hidden');
                    setTimeout(() => saveIndicator.classList.add('hidden'), 1500);
                }
            }, 800);
        }
        editor.addEventListener('input', scheduleAutoSave);

        // --- Clear output ---
        if (clearBtn) {
            clearBtn.addEventListener('click', () => {
                output.textContent = '';
                output.innerHTML = '';
            });
        }

        // --- Keyboard shortcuts ---
        editor.addEventListener('keydown', (e) => {
            if ((e.ctrlKey || e.metaKey) && e.key === 'Enter') {
                e.preventDefault();
                document.getElementById('run-btn').click();
            }
            if ((e.ctrlKey || e.metaKey) && e.key === 'l') {
                e.preventDefault();
                output.textContent = '';
                output.innerHTML = '';
            }
        });

        // --- Resizer (percentage-based) ---
        const MIN_EDITOR_PCT = 40;
        const MIN_OUTPUT_PCT = 30;
        let isDragging = false;
        let editorPct = 55;
        let hasCustomWidth = false;
        let startX = 0;
        let startPct = 55;

        function setMobileLayout() {
            editorPane.style.width = '';
            terminalPane.style.width = '';
            editorPane.style.flex = '';
            terminalPane.style.flex = '';
        }

        function applyPct(pct) {
            const clamped = Math.max(MIN_EDITOR_PCT, Math.min(100 - MIN_OUTPUT_PCT, pct));
            editorPct = clamped;
            editorPane.style.flex = `0 0 ${clamped}%`;
            terminalPane.style.flex = `0 0 ${100 - clamped}%`;
        }

        function syncLayout() {
            if (!desktopQuery.matches) { setMobileLayout(); return; }
            applyPct(hasCustomWidth ? editorPct : 55);
        }

        // --- Cursor position ---
        function updateCursorPosition() {
            if (!cursorPosition || !window.EditorHelpers) return;
            const offset = window.EditorHelpers.getCaretOffset(editor);
            if (offset === null) return;
            const source = editor.textContent || '';
            const safe = Math.max(0, Math.min(offset, source.length));
            const before = source.slice(0, safe);
            const line = before.split('\n').length;
            const col = before.length - before.lastIndexOf('\n');
            cursorPosition.textContent = `Ln ${line}, Col ${col}`;
        }

        function stopResize() {
            if (!isDragging) return;
            isDragging = false;
            document.body.style.userSelect = '';
            document.body.style.cursor = '';
        }

        resizer.addEventListener('pointerdown', (e) => {
            if (!desktopQuery.matches) return;
            e.preventDefault();
            isDragging = true;
            hasCustomWidth = true;
            startX = e.clientX;
            startPct = editorPct;
            document.body.style.userSelect = 'none';
            document.body.style.cursor = 'col-resize';
            if (resizer.setPointerCapture) resizer.setPointerCapture(e.pointerId);
        });
        resizer.addEventListener('pointermove', (e) => {
            if (!isDragging || !desktopQuery.matches) return;
            const totalWidth = workspace.getBoundingClientRect().width;
            if (totalWidth <= 0) return;
            const deltaPct = ((e.clientX - startX) / totalWidth) * 100;
            applyPct(startPct + deltaPct);
        });
        resizer.addEventListener('pointerup', stopResize);
        resizer.addEventListener('pointercancel', stopResize);
        resizer.addEventListener('lostpointercapture', stopResize);
        window.addEventListener('resize', syncLayout);
        if (desktopQuery.addEventListener) desktopQuery.addEventListener('change', syncLayout);

        editor.addEventListener('keyup', updateCursorPosition);
        editor.addEventListener('click', updateCursorPosition);
        editor.addEventListener('input', () => requestAnimationFrame(updateCursorPosition));
        document.addEventListener('selectionchange', () => {
            const sel = window.getSelection();
            if (sel && sel.rangeCount > 0 && editor.contains(sel.anchorNode)) updateCursorPosition();
        });

        syncLayout();
        requestAnimationFrame(updateCursorPosition);
    });
</script>
