{% include "pyodide-runtime.njk" %}
<script>
(function() {
    function getCaretOffset(container) {
        const selection = window.getSelection();
        if (!selection || selection.rangeCount === 0) {
            return null;
        }

        const range = selection.getRangeAt(0);
        if (!container.contains(range.endContainer)) {
            return null;
        }

        const preCaretRange = range.cloneRange();
        preCaretRange.selectNodeContents(container);
        preCaretRange.setEnd(range.endContainer, range.endOffset);
        return preCaretRange.toString().length;
    }

    function setCaretOffset(container, offset) {
        const safeOffset = Math.max(0, offset || 0);
        const selection = window.getSelection();
        if (!selection) {
            return;
        }

        const walker = document.createTreeWalker(container, NodeFilter.SHOW_TEXT);
        let currentOffset = 0;
        let targetNode = null;
        let targetOffset = 0;
        let node = walker.nextNode();

        while (node) {
            const nextOffset = currentOffset + node.nodeValue.length;
            if (safeOffset <= nextOffset) {
                targetNode = node;
                targetOffset = safeOffset - currentOffset;
                break;
            }
            currentOffset = nextOffset;
            node = walker.nextNode();
        }

        const range = document.createRange();
        if (targetNode) {
            range.setStart(targetNode, targetOffset);
        } else {
            range.selectNodeContents(container);
            range.collapse(false);
        }
        range.collapse(true);
        selection.removeAllRanges();
        selection.addRange(range);
    }

    function renderHighlightedEditable(editor, language, baseClassName) {
        const source = editor.textContent || "";
        const caretOffset = getCaretOffset(editor);

        if (window.hljs) {
            const highlighted = hljs.highlight(source, {
                language,
                ignoreIllegals: true
            }).value;
            editor.innerHTML = highlighted;
            editor.className = `${baseClassName} hljs`;
        } else {
            editor.textContent = source;
            editor.className = baseClassName;
        }

        if (caretOffset !== null) {
            setCaretOffset(editor, Math.min(caretOffset, (editor.textContent || "").length));
        }
    }

    const editor = document.getElementById('editor');
    const output = document.getElementById('output');
    const runBtn = document.getElementById('run-btn');
    const status = document.getElementById('status-badge');
    const baseClassName = (editor.className || "").split(/\s+/).filter((cls) => cls && cls !== "hljs").join(" ");
    const languageMatch = baseClassName.match(/language-([a-z0-9-]+)/i);
    const editorLanguage = languageMatch ? languageMatch[1] : "json";
    let highlightQueued = false;
    const queueHighlight = () => {
        if (highlightQueued) {
            return;
        }
        highlightQueued = true;
        requestAnimationFrame(() => {
            highlightQueued = false;
            renderHighlightedEditable(editor, editorLanguage, baseClassName);
        });
    };

    editor.setAttribute('contenteditable', 'true');
    editor.setAttribute('spellcheck', 'false');
    editor.addEventListener('input', queueHighlight);
    editor.addEventListener('paste', (event) => {
        event.preventDefault();
        const text = (event.clipboardData || window.clipboardData).getData('text');
        document.execCommand('insertText', false, text);
    });
    editor.addEventListener('focus', () => {
        editor.className = `${baseClassName} hljs`;
    });
    renderHighlightedEditable(editor, editorLanguage, baseClassName);

    runBtn.addEventListener('click', async () => {
        output.textContent = 'Converting...';
        status.textContent = 'Working...';
        runBtn.disabled = true;

        try {
            const runCode = `
import json
import pprint

try:
    data = json.loads(json_input)
    # pprint with sort_dicts=False to keep order if Python 3.8+
    print(pprint.pformat(data, width=80, sort_dicts=False))
except json.JSONDecodeError as e:
    print(f"Invalid JSON: {e}")
except Exception as e:
    print(f"Error: {e}")
            `;
            const result = await window.PyRuntime.run(runCode, {
                timeoutMs: 12000,
                useWorker: true,
                globals: {
                    json_input: editor.textContent || ""
                }
            });
            output.textContent = [result.stdout, result.stderr].filter(Boolean).join("\\n");
            status.textContent = 'Done';
            
        } catch (err) {
            output.textContent = "Error: " + err.message;
            status.textContent = 'Failed';
        } finally {
            runBtn.disabled = false;
        }
    });
})();
</script>
