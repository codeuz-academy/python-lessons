<!DOCTYPE html>
{% set currentUrl = page.url or '/' %}
{% set isUzPage = (page.lang or lang or '') == 'uz' or currentUrl == '/uz/' or currentUrl.startsWith('/uz/') %}
{% set isDsPage = currentUrl.startsWith('/en/data-structures/') or currentUrl.startsWith('/uz/data-structures/') %}
{% set isAlgoPage = currentUrl.startsWith('/en/algorithms/') or currentUrl.startsWith('/uz/algorithms/') %}
{% if isDsPage %}
  {% set dsaItems = collections.dataStructuresUz if isUzPage else collections.dataStructures %}
{% else %}
  {% set dsaItems = collections.algorithmsUz if isUzPage else collections.algorithms %}
{% endif %}
<html lang="{{ lang or 'en' }}">
  {% set isTutorial = true %}
  {% set useBrandIconFont = true %}
  {% include "head.njk" %}
  <body class="overflow-x-hidden">
    {% include "navbar.njk" %}
    <!-- Mobile Sidebar Drawer -->
    <div
      id="tutorial-sidebar-overlay"
      class="fixed inset-0 bg-black/50 z-[70] hidden transition-opacity duration-300 opacity-0 md:hidden"></div>
    <div
      id="tutorial-sidebar-drawer"
      data-sidebar-scroll="mobile"
      class="fixed top-0 left-0 h-full w-4/5 max-w-[280px] bg-white z-[80] transform -translate-x-full transition-transform
        duration-300 md:hidden overflow-y-auto custom-scrollbar shadow-2xl">
      <div class="p-4 md:p-6">
        <div class="flex justify-between items-center mb-6">
          <h2 class="text-xl font-bold text-primary-500">DSA Material</h2>
          <button id="close-tutorial-sidebar" class="text-slate-400 hover:text-slate-600 focus:outline-none">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
            </svg>
          </button>
        </div>
        <div class="mobile-sidebar-content">
          {% include "dsa-sidebar-list.njk" %}
        </div>
      </div>
    </div>
    <div class="max-w-4xl mx-auto py-10 flex">
      <aside id="tutorial-sidebar-desktop" data-sidebar-scroll="desktop" class="hidden md:block md:w-3/12 sticky top-24 self-start h-[calc(100vh-6rem)] overflow-y-auto custom-scrollbar pr-4">
        {% include "dsa-sidebar-list.njk" %}
      </aside>
      <main class="w-full min-w-0 pb-2 px-4 md:w-9/12 tutorial">
        <div class="flex flex-col md:flex-row justify-between items-center mb-5 gap-4">
          <h1 class="text-primary-500 font-medium text-3xl flex-1">{{ title }}</h1>
          <div class="flex flex-col items-start justify-center md:items-end shrink-0 gap-[10px]">
            <span class="text-xs text-slate-500 pl-[30px] font-medium uppercase tracking-wide text-center">Share to</span>
            <div class="flex items-center gap-2.5">
              <a
                href="https://threads.net/intent/post?text={{ title | urlencode }}%20{{ site.url }}{{ page.url }}"
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex h-6 w-6 items-center justify-center no-underline hover:no-underline hover:opacity-80 transition-opacity"
                title="Share on Threads">
                <i class="fa-brands fa-threads text-[20px] leading-none text-black" aria-hidden="true"></i>
              </a>
              <a
                href="https://wa.me/?text={{ title | urlencode }}%20{{ site.url }}{{ page.url }}"
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex h-6 w-6 items-center justify-center no-underline hover:no-underline hover:opacity-80 transition-opacity"
                title="Share on WhatsApp">
                <i class="fa-brands fa-whatsapp text-[20px] leading-none text-[#25D366]" aria-hidden="true"></i>
              </a>
              <a
                href="https://twitter.com/intent/tweet?text={{ title | urlencode }}&url={{ site.url }}{{ page.url }}"
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex h-6 w-6 items-center justify-center no-underline hover:no-underline hover:opacity-80 transition-opacity"
                title="Share on X">
                <i class="fa-brands fa-x-twitter text-[20px] leading-none text-black" aria-hidden="true"></i>
              </a>
              <a
                href="https://www.linkedin.com/sharing/share-offsite/?url={{ site.url }}{{ page.url }}"
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex h-6 w-6 items-center justify-center no-underline hover:no-underline hover:opacity-80 transition-opacity"
                title="Share on LinkedIn">
                <i class="fa-brands fa-linkedin-in text-[20px] leading-none text-[#0A66C2]" aria-hidden="true"></i>
              </a>
            </div>
          </div>
        </div>
        {{ content | safe }}
        {% set dsaNav = dsaItems | getTutorialNav(page.url) %}
        <div class="mt-8">
          {% set sourcePath = sourceInputPath or page.inputPath %}
          {% set lastEditedDate = sourcePath | fileLastModified('en') %}
          <p class="mb-2 text-sm text-slate-500">
            <a
              href="https://github.com/codeuzhub/python-lessons/blob/main/{{ sourcePath | replace('./', '') }}"
              class="hover:text-primary-500">
              Edit this page
            </a>
          </p>
          {% if lastEditedDate %}
            <p class="mb-6 text-xs text-slate-400">
              Last updated: {{ lastEditedDate }}
            </p>
          {% endif %}
          <div class="flex justify-between gap-x-2 md:gap-x-4">
            <div class="flex justify-start">
              {% if dsaNav.prev %}
                <a href="{{ dsaNav.prev.url }}" class="no-underline text-primary-300 hover:text-primary-300 flex h-10 md:h-12 items-center rounded-full bg-blue-500 bg-opacity-20 px-4 md:px-8 text-sm md:text-base shadow-xl hover:no-underline hover:shadow">
                  <svg xmlns="http://www.w3.org/2000/svg" class="mr-1 h-4 w-4 md:h-5 md:w-5" viewBox="0 0 20 20" fill="currentColor">
                    <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm.707-10.293a1 1 0 00-1.414-1.414l-3 3a1 1 0 000 1.414l3 3a1 1 0 001.414-1.414L9.414 11H13a1 1 0 100-2H9.414l1.293-1.293z" clip-rule="evenodd" />
                  </svg>
                  <span class="-mt-0.5">{{ dsaNav.prev.data.title }}</span>
                </a>
              {% endif %}
            </div>
            <div class="flex justify-end">
              {% if dsaNav.next %}
                <a href="{{ dsaNav.next.url }}" class="no-underline flex h-10 md:h-12 items-center rounded-full bg-gradient-to-l from-yellow-500 to-yellow-400 px-4 md:px-8 text-sm md:text-base text-black shadow-xl hover:text-black hover:no-underline hover:shadow">
                  <span class="-mt-0.5">{{ dsaNav.next.data.title }}</span>
                  <svg xmlns="http://www.w3.org/2000/svg" class="ml-1 h-4 w-4 md:h-5 md:w-5" viewBox="0 0 20 20" fill="currentColor">
                    <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-8.707l-3-3a1 1 0 00-1.414 1.414L10.586 9H7a1 1 0 100 2h3.586l-1.293 1.293a1 1 0 101.414 1.414l3-3a1 1 0 000-1.414z" clip-rule="evenodd" />
                  </svg>
                </a>
              {% else %}
                {% if isDsPage %}
                  {% set algoUrl = '/uz/algorithms/' if isUzPage else '/en/algorithms/' %}
                  {% set algoLabel = 'Algoritmlar' if isUzPage else 'Algorithms' %}
                  <a href="{{ algoUrl | url }}" class="no-underline flex h-10 md:h-12 items-center rounded-full bg-gradient-to-l from-yellow-500 to-yellow-400 px-4 md:px-8 text-sm md:text-base text-black shadow-xl hover:text-black hover:no-underline hover:shadow">
                    <span class="-mt-0.5">{{ algoLabel }}</span>
                    <svg xmlns="http://www.w3.org/2000/svg" class="ml-1 h-4 w-4 md:h-5 md:w-5" viewBox="0 0 20 20" fill="currentColor">
                      <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-8.707l-3-3a1 1 0 00-1.414 1.414L10.586 9H7a1 1 0 100 2h3.586l-1.293 1.293a1 1 0 101.414 1.414l3-3a1 1 0 000-1.414z" clip-rule="evenodd" />
                    </svg>
                  </a>
                {% else %}
                  {% set startLabel = 'Boshiga qaytish' if isUzPage else 'Back to Start' %}
                  <a href="{{ (dsaItems | first).url if (dsaItems | length) else (dsaNav.first.url if dsaNav.first else '#') }}" class="no-underline flex h-10 md:h-12 items-center rounded-full bg-gradient-to-l from-yellow-500 to-yellow-400 px-4 md:px-8 text-sm md:text-base text-black shadow-xl hover:text-black hover:no-underline hover:shadow">
                    <span class="-mt-0.5">{{ startLabel }}</span>
                    <svg xmlns="http://www.w3.org/2000/svg" class="ml-1 h-4 w-4 md:h-5 md:w-5" viewBox="0 0 20 20" fill="currentColor">
                      <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-8.707l-3-3a1 1 0 00-1.414 1.414L10.586 9H7a1 1 0 100 2h3.586l-1.293 1.293a1 1 0 101.414 1.414l3-3a1 1 0 000-1.414z" clip-rule="evenodd" />
                    </svg>
                  </a>
                {% endif %}
              {% endif %}
            </div>
          </div>
        </div>
      </main>
    </div>
    {% set footerVariant = 'compact' %}
    {% set compactFooterShowLinks = false %}
    {% include "footer.njk" %}
    {% include "analytics.njk" %}
    <script>
      (function () {
        const toggleBtn = document.getElementById('mobile-tutorial-sidebar-toggle');
        const closeBtn = document.getElementById('close-tutorial-sidebar');
        const overlay = document.getElementById('tutorial-sidebar-overlay');
        const desktopSidebar = document.getElementById('tutorial-sidebar-desktop');
        const drawer = document.getElementById('tutorial-sidebar-drawer');
        const body = document.body;
        const DESKTOP_SCROLL_KEY = 'dsa_sidebar_scroll_desktop';
        const MOBILE_SCROLL_KEY = 'dsa_sidebar_scroll_mobile';

        function getSavedScroll(key) {
          try {
            const value = window.sessionStorage.getItem(key);
            if (value === null) {
              return null;
            }
            const parsed = Number.parseInt(value, 10);
            return Number.isNaN(parsed) ? null : parsed;
          } catch (_error) {
            return null;
          }
        }

        function saveScroll(key, value) {
          try {
            window.sessionStorage.setItem(key, String(Math.max(0, value || 0)));
          } catch (_error) {
          }
        }

        function persistSidebarScrollPosition() {
          if (desktopSidebar) {
            saveScroll(DESKTOP_SCROLL_KEY, desktopSidebar.scrollTop);
          }

          if (drawer) {
            saveScroll(MOBILE_SCROLL_KEY, drawer.scrollTop);
          }
        }

        function restoreSidebarScrollPosition() {
          if (desktopSidebar) {
            const savedDesktopScroll = getSavedScroll(DESKTOP_SCROLL_KEY);
            if (savedDesktopScroll !== null) {
              desktopSidebar.scrollTop = savedDesktopScroll;
            }
          }

          if (drawer) {
            const savedMobileScroll = getSavedScroll(MOBILE_SCROLL_KEY);
            if (savedMobileScroll !== null) {
              drawer.scrollTop = savedMobileScroll;
            }
          }
        }

        restoreSidebarScrollPosition();
        window.requestAnimationFrame(restoreSidebarScrollPosition);
        window.addEventListener('load', restoreSidebarScrollPosition, { once: true });

        if (desktopSidebar) {
          desktopSidebar.addEventListener('scroll', function () {
            saveScroll(DESKTOP_SCROLL_KEY, desktopSidebar.scrollTop);
          }, { passive: true });
        }

        if (drawer) {
          drawer.addEventListener('scroll', function () {
            saveScroll(MOBILE_SCROLL_KEY, drawer.scrollTop);
          }, { passive: true });
        }

        const sidebarLinks = document.querySelectorAll('[data-sidebar-link="true"]');
        sidebarLinks.forEach((link) => {
          link.addEventListener('click', persistSidebarScrollPosition, { passive: true });
        });

        window.addEventListener('pagehide', persistSidebarScrollPosition);

        function toggleSidebar() {
          const isOpen = !drawer.classList.contains('-translate-x-full');
          if (!isOpen) {
            overlay.classList.remove('hidden');
            setTimeout(() => {
              overlay.classList.add('opacity-100');
              drawer.classList.remove('-translate-x-full');
            }, 10);
            body.classList.add('overflow-hidden');
          } else {
            overlay.classList.remove('opacity-100');
            drawer.classList.add('-translate-x-full');
            setTimeout(() => {
              overlay.classList.add('hidden');
            }, 300);
            body.classList.remove('overflow-hidden');
          }
        }

        if (toggleBtn) {
          toggleBtn.addEventListener('click', toggleSidebar);
        }
        if (closeBtn) {
          closeBtn.addEventListener('click', toggleSidebar);
        }
        if (overlay) {
          overlay.addEventListener('click', toggleSidebar);
        }
      })();
    </script>
    {% include "python-runner.njk" %}
    <script src="{{ '/js/mermaid-runner.js' | url }}"></script>
  </body>
</html>
