<script src="https://cdn.jsdelivr.net/pyodide/v0.25.0/full/pyodide.js"></script>
<script>
  (function () {
    let pyodidePromise = null;

    async function getPyodide() {
      if (!pyodidePromise) {
        pyodidePromise = loadPyodide();
      }
      return pyodidePromise;
    }

    function getCaretOffset(container) {
      const selection = window.getSelection();
      if (!selection || selection.rangeCount === 0) {
        return null;
      }

      const range = selection.getRangeAt(0);
      if (!container.contains(range.endContainer)) {
        return null;
      }

      const preCaretRange = range.cloneRange();
      preCaretRange.selectNodeContents(container);
      preCaretRange.setEnd(range.endContainer, range.endOffset);
      return preCaretRange.toString().length;
    }

    function setCaretOffset(container, offset) {
      const safeOffset = Math.max(0, offset || 0);
      const selection = window.getSelection();
      if (!selection) {
        return;
      }

      const walker = document.createTreeWalker(container, NodeFilter.SHOW_TEXT);
      let currentOffset = 0;
      let targetNode = null;
      let targetOffset = 0;
      let node = walker.nextNode();

      while (node) {
        const nextOffset = currentOffset + node.nodeValue.length;
        if (safeOffset <= nextOffset) {
          targetNode = node;
          targetOffset = safeOffset - currentOffset;
          break;
        }
        currentOffset = nextOffset;
        node = walker.nextNode();
      }

      const range = document.createRange();
      if (targetNode) {
        range.setStart(targetNode, targetOffset);
      } else {
        range.selectNodeContents(container);
        range.collapse(false);
      }
      range.collapse(true);
      selection.removeAllRanges();
      selection.addRange(range);
    }

    function renderHighlightedEditable(editor, language, baseClassName) {
      const source = editor.textContent || "";
      const caretOffset = getCaretOffset(editor);

      if (window.hljs) {
        const highlighted = hljs.highlight(source, {
          language,
          ignoreIllegals: true
        }).value;
        editor.innerHTML = highlighted;
        editor.className = `${baseClassName} hljs`;
      } else {
        editor.textContent = source;
        editor.className = baseClassName;
      }

      if (caretOffset !== null) {
        setCaretOffset(editor, Math.min(caretOffset, (editor.textContent || "").length));
      }
    }

    function getRunCode(mode) {
      if (mode === "minify") {
        return `
import ast

class DocstringRemover(ast.NodeTransformer):
    def _strip_docstring(self, node):
        if getattr(node, "body", None):
            if node.body and isinstance(node.body[0], ast.Expr):
                value = getattr(node.body[0], "value", None)
                if isinstance(value, ast.Constant) and isinstance(value.value, str):
                    node.body = node.body[1:]
        return node

    def visit_Module(self, node):
        self.generic_visit(node)
        return self._strip_docstring(node)

    def visit_FunctionDef(self, node):
        self.generic_visit(node)
        return self._strip_docstring(node)

    def visit_AsyncFunctionDef(self, node):
        self.generic_visit(node)
        return self._strip_docstring(node)

    def visit_ClassDef(self, node):
        self.generic_visit(node)
        return self._strip_docstring(node)

try:
    parsed = ast.parse(input_code)
    transformed = DocstringRemover().visit(parsed)
    ast.fix_missing_locations(transformed)
    print(ast.unparse(transformed))
except Exception as e:
    print(f"Error: {e}")
        `;
      }

      return `
import ast
try:
    parsed = ast.parse(input_code)
    print(ast.unparse(parsed))
except Exception as e:
    print(f"Error parsing code: {e}")
      `;
    }

    window.initAstTransformTool = function initAstTransformTool(config) {
      const editor = document.getElementById("editor");
      const output = document.getElementById("output");
      const runBtn = document.getElementById("run-btn");
      const resetBtn = document.getElementById("reset-btn");
      const status = document.getElementById("status-badge");

      if (!editor || !output || !runBtn || !status) {
        return;
      }

      const baseClassName = (editor.className || "").split(/\s+/).filter((cls) => cls && cls !== "hljs").join(" ");
      const languageMatch = baseClassName.match(/language-([a-z0-9-]+)/i);
      const editorLanguage = languageMatch ? languageMatch[1] : "python";
      let highlightQueued = false;
      const queueHighlight = () => {
        if (highlightQueued) {
          return;
        }
        highlightQueued = true;
        requestAnimationFrame(() => {
          highlightQueued = false;
          renderHighlightedEditable(editor, editorLanguage, baseClassName);
        });
      };

      editor.setAttribute("contenteditable", "true");
      editor.setAttribute("spellcheck", "false");
      editor.addEventListener("input", queueHighlight);
      editor.addEventListener("paste", (event) => {
        event.preventDefault();
        const text = (event.clipboardData || window.clipboardData).getData("text");
        document.execCommand("insertText", false, text);
      });
      editor.addEventListener("focus", () => {
        editor.className = `${baseClassName} hljs`;
      });
      renderHighlightedEditable(editor, editorLanguage, baseClassName);

      runBtn.addEventListener("click", async () => {
        output.textContent = config.runningOutputText;
        status.textContent = config.runningStatusText;
        runBtn.disabled = true;

        try {
          const py = await getPyodide();
          py.globals.set("input_code", editor.textContent || "");

          const runCode = getRunCode(config.mode);
          let stdout = "";
          py.setStdout({
            batched: (str) => {
              stdout += str + "\\n";
            }
          });
          await py.runPythonAsync(runCode);

          output.textContent = stdout;
          status.textContent = "Done";
        } catch (err) {
          output.textContent = "Error: " + err.message;
          status.textContent = "Failed";
        } finally {
          runBtn.disabled = false;
        }
      });

      if (resetBtn) {
        resetBtn.addEventListener("click", () => {
          editor.textContent = config.resetValue || "";
          renderHighlightedEditable(editor, editorLanguage, baseClassName);
          output.textContent = "";
          status.textContent = "Ready";
        });
      }
    };
  })();
</script>
