{% set currentUrl = page.url or '/' %}
{% set isEnTutorial = currentUrl.startsWith('/tutorial/en/') %}
{% set isUzTutorial = currentUrl.startsWith('/tutorial/uz/') %}
{% set isUzPage = (lang or '') == 'uz' or currentUrl == '/uz/' or currentUrl.startsWith('/uz/') or isUzTutorial %}
{% set enUrl = currentUrl | replace('/tutorial/uz/', '/tutorial/en/') if isUzTutorial else '/' %}
{% set uzUrl = currentUrl | replace('/tutorial/en/', '/tutorial/uz/') if isEnTutorial else '/uz/' %}
{% set homeUrl = '/uz/' if isUzPage else '/' %}
{% set tutorialUrl = '/tutorial/uz/what-is-python/' if isUzPage else '/tutorial/en/what-is-python/' %}
{% set tutorialLabel = "Darslar" if isUzPage else "Tutorial" %}
{% set githubLabel = "GitHub'da qo'shiling" if isUzPage else "Join on Github" %}
{% set languageSwitchUrl = '/uz/' if not isUzPage else '/' %}
{% if currentUrl == '/' %}
  {% set languageSwitchUrl = '/uz/' %}
{% elif currentUrl == '/uz/' %}
  {% set languageSwitchUrl = '/' %}
{% elif isEnTutorial %}
  {% set languageSwitchUrl = uzUrl %}
{% elif isUzTutorial %}
  {% set languageSwitchUrl = enUrl %}
{% endif %}
{% set languageSwitchAriaLabel = "Switch to English" if isUzPage else "Switch to Uzbek" %}
{% set languageSwitchCode = "EN" if isUzPage else "UZ" %}

<nav class="h-16 bg-primary-500 text-white {{ 'fixed top-0 left-0 right-0 z-[60] shadow-md' if not isHomepage }}">
    <div class="relative flex items-center justify-center md:justify-between pt-3 max-w-7xl px-4 md:px-10 mx-auto">
        {% if isTutorial %}
            <button
                id="mobile-tutorial-sidebar-toggle"
                class="absolute left-4 top-4 md:hidden text-white focus:outline-none"
                aria-label="Toggle Sidebar">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
                </svg>
            </button>
        {% endif %}
        <a href="{{ homeUrl | url }}" class="z-10">
            <img class="h-10 pt-1" src="{{ '/img/logo-belajarpython-140.png' | url }}" alt="logo-belajarpython"/>
        </a>
        <div class="absolute right-4 top-[13px] md:hidden">
            <a
                href="{{ languageSwitchUrl | url }}"
                aria-label="{{ languageSwitchAriaLabel }}"
                class="inline-flex items-center gap-1.5 rounded-full bg-white px-2 py-1 text-[11px] font-bold leading-none text-slate-900 shadow-sm transition hover:bg-slate-100 focus:outline-none focus-visible:ring-2 focus-visible:ring-white/70 focus-visible:ring-offset-2 focus-visible:ring-offset-primary-500">
                <span
                    aria-hidden="true"
                    class="relative h-5 w-5 overflow-hidden rounded-full border border-slate-300 shadow-sm">
                    {% if not isUzPage %}
                        <span
                            class="absolute inset-0"
                            style="background: linear-gradient(to bottom, #1eb6f0 0 31%, #ce1126 31% 35%, #ffffff 35% 65%, #ce1126 65% 69%, #1eb53a 69% 100%);"></span>
                    {% else %}
                        <span
                            class="absolute inset-0"
                            style="background: repeating-linear-gradient(to bottom, #b22234 0 14.3%, #ffffff 14.3% 28.6%);"></span>
                        <span class="absolute left-0 top-0 h-[55%] w-[45%] bg-[#3c3b6e]"></span>
                    {% endif %}
                </span>
                <span>{{ languageSwitchCode }}</span>
            </a>
        </div>
        <div class="hidden md:flex items-center justify-end">
            <div class="mr-5 flex items-center gap-4">
                <a
                    class="text-center text-white/80 hover:text-white whitespace-nowrap"
                    href="{{ tutorialUrl | url }}">
                    {{ tutorialLabel }}
                </a>
                <a
                    href="{{ languageSwitchUrl | url }}"
                    aria-label="{{ languageSwitchAriaLabel }}"
                    class="inline-flex items-center gap-1.5 rounded-full bg-white px-2.5 py-1 text-xs font-bold leading-none text-slate-900 shadow-sm transition hover:bg-slate-100 focus:outline-none focus-visible:ring-2 focus-visible:ring-white/70 focus-visible:ring-offset-2 focus-visible:ring-offset-primary-500">
                    <span
                        aria-hidden="true"
                        class="relative h-5 w-5 overflow-hidden rounded-full border border-slate-300 shadow-sm">
                        {% if not isUzPage %}
                            <span
                                class="absolute inset-0"
                                style="background: linear-gradient(to bottom, #1eb6f0 0 31%, #ce1126 31% 35%, #ffffff 35% 65%, #ce1126 65% 69%, #1eb53a 69% 100%);"></span>
                        {% else %}
                            <span
                                class="absolute inset-0"
                                style="background: repeating-linear-gradient(to bottom, #b22234 0 14.3%, #ffffff 14.3% 28.6%);"></span>
                            <span class="absolute left-0 top-0 h-[55%] w-[45%] bg-[#3c3b6e]"></span>
                        {% endif %}
                    </span>
                    <span>{{ languageSwitchCode }}</span>
                </a>
            </div>
            <a
                class="inline-flex h-9 w-[210px] items-center justify-center rounded-full bg-gradient-to-l from-secondary-500 to-secondary-400 text-sm text-black whitespace-nowrap"
                href="https://github.com/codeuzhub/python-lessons">
                <span class="-mt-0.5">{{ githubLabel }}</span>
                <i class="fa-brands fa-github ml-2 text-lg" aria-hidden="true"></i>
            </a>
        </div>
    </div>
</nav>
{% if not isHomepage %}
    <div class="h-16"></div>
{% endif %}
