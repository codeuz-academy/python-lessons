<style>
:root {
  --tool-bg: #1e293b;
  --tool-header: #334155;
  --tool-border: #475569;
  --tool-text: #f1f5f9;
  --tool-accent: #38bdf8;
  --tool-success: #22c55e;
  --tool-error: #ef4444;
  --tool-terminal: #0f172a;
  --tool-output-text: #e2e8f0;
}

.python-tool-container {
  display: flex;
  flex-direction: column;
  height: 100%;
}

.python-tool-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: var(--tool-header);
  padding: 0.5rem 1rem;
  border-bottom: 1px solid var(--tool-border);
}

.python-tool-title {
  color: var(--tool-text);
  font-weight: 600;
  display: flex;
  align-items: center;
  gap: 0.5rem;
}

.python-tool-actions {
  display: flex;
  gap: 0.5rem;
  align-items: center;
}

.btn-tool {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 0.25rem;
  padding: 0.375rem 0.75rem;
  border-radius: 6px;
  font-size: 0.8125rem;
  font-weight: 500;
  cursor: pointer;
  transition: all 0.2s;
  border: 1px solid transparent;
}

.btn-tool-run {
  background: var(--tool-accent);
  color: #0f172a;
  font-weight: 600;
}

.btn-tool-run:hover {
  filter: brightness(1.1);
  box-shadow: 0 0 10px rgba(56, 189, 248, 0.3);
}

.btn-tool-reset {
  background: transparent;
  color: #94a3b8;
  border: 1px solid #475569;
}

.btn-tool-reset:hover {
  color: #fff;
  border-color: #94a3b8;
}

.python-tool-editor-area {
  flex: 1;
  position: relative;
  background: var(--tool-bg);
  min-height: 0;
  overflow: auto;
}

.python-tool-editor-area pre {
  margin: 0 !important;
  padding: 1rem !important;
  background: transparent !important;
  min-height: 100%;
}

.python-tool-editor-area code {
  font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
  font-size: 0.875rem;
  line-height: 1.6;
  background: transparent !important;
  padding: 0 !important;
  color: var(--tool-text);
  caret-color: var(--tool-text);
  outline: none;
  min-height: 100%;
  display: block;
}

.python-tool-output-area {
  background: var(--tool-terminal);
  color: var(--tool-output-text);
  font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
  font-size: 0.875rem;
  padding: 1rem;
  overflow-y: auto;
  min-height: 100px;
  max-height: 100%;
  white-space: pre-wrap;
  border-left: 1px solid var(--tool-border);
}

/* Loading overlay */
.tool-loading {
  position: absolute;
  inset: 0;
  background: rgba(15, 23, 42, 0.8);
  display: none;
  align-items: center;
  justify-content: center;
  flex-direction: column;
  z-index: 50;
  color: white;
}
.tool-loading.active {
  display: flex;
}
.tool-spinner {
  width: 30px;
  height: 30px;
  border: 3px solid rgba(255, 255, 255, 0.1);
  border-top-color: var(--tool-accent);
  border-radius: 50%;
  animation: spin 1s linear infinite;
  margin-bottom: 0.5rem;
}

</style>

{% include "pyodide-runtime.njk" %}
<script>
(function() {
  function getCaretOffset(container) {
    const selection = window.getSelection();
    if (!selection || selection.rangeCount === 0) {
      return null;
    }

    const range = selection.getRangeAt(0);
    if (!container.contains(range.endContainer)) {
      return null;
    }

    const preCaretRange = range.cloneRange();
    preCaretRange.selectNodeContents(container);
    preCaretRange.setEnd(range.endContainer, range.endOffset);
    return preCaretRange.toString().length;
  }

  function getSelectionOffsets(container) {
    const selection = window.getSelection();
    if (!selection || selection.rangeCount === 0) {
      return null;
    }

    const range = selection.getRangeAt(0);
    if (!container.contains(range.startContainer) || !container.contains(range.endContainer)) {
      return null;
    }

    const startRange = range.cloneRange();
    startRange.selectNodeContents(container);
    startRange.setEnd(range.startContainer, range.startOffset);

    const endRange = range.cloneRange();
    endRange.selectNodeContents(container);
    endRange.setEnd(range.endContainer, range.endOffset);

    return {
      start: startRange.toString().length,
      end: endRange.toString().length
    };
  }

  function setCaretOffset(container, offset) {
    const safeOffset = Math.max(0, offset || 0);
    const selection = window.getSelection();
    if (!selection) {
      return;
    }

    const walker = document.createTreeWalker(container, NodeFilter.SHOW_TEXT);
    let currentOffset = 0;
    let targetNode = null;
    let targetOffset = 0;
    let node = walker.nextNode();

    while (node) {
      const nextOffset = currentOffset + node.nodeValue.length;
      if (safeOffset <= nextOffset) {
        targetNode = node;
        targetOffset = safeOffset - currentOffset;
        break;
      }
      currentOffset = nextOffset;
      node = walker.nextNode();
    }

    const range = document.createRange();
    if (targetNode) {
      range.setStart(targetNode, targetOffset);
    } else {
      range.selectNodeContents(container);
      range.collapse(false);
    }
    range.collapse(true);
    selection.removeAllRanges();
    selection.addRange(range);
  }

  function renderHighlightedEditable(editor, language, baseClassName) {
    const source = editor.textContent || "";
    const caretOffset = getCaretOffset(editor);

    if (window.hljs) {
      const highlighted = hljs.highlight(source, {
        language,
        ignoreIllegals: true
      }).value;
      editor.innerHTML = highlighted;
      editor.className = `${baseClassName} hljs`;
    } else {
      editor.textContent = source;
      editor.className = baseClassName;
    }

    if (caretOffset !== null) {
      setCaretOffset(editor, Math.min(caretOffset, (editor.textContent || "").length));
    }
  }

  window.initPythonTool = function(editorId, outputId, runBtnId, resetBtnId, statusId) {
    const editor = document.getElementById(editorId);
    const output = document.getElementById(outputId);
    const runBtn = document.getElementById(runBtnId);
    const resetBtn = document.getElementById(resetBtnId);
    const status = document.getElementById(statusId);
    const baseClassName = (editor.className || "").split(/\s+/).filter((cls) => cls && cls !== "hljs").join(" ");
    const languageMatch = baseClassName.match(/language-([a-z0-9-]+)/i);
    const editorLanguage = languageMatch ? languageMatch[1] : "python";

    const initialCode = editor.textContent || "";
    editor.textContent = initialCode;
    
    // Store original code for reset
    const originalCode = editor.textContent || "";
    
    // Loading overlay logic (simple implementation)
    const loadingOverlay = document.createElement('div');
    loadingOverlay.className = 'tool-loading';
    loadingOverlay.innerHTML = '<div class="tool-spinner"></div><div>Initializing Python...</div>';
    editor.parentElement.appendChild(loadingOverlay);

    // Make editable
    editor.setAttribute('contenteditable', 'true');
    editor.setAttribute('spellcheck', 'false');
    let highlightQueued = false;
    const queueHighlight = () => {
        if (highlightQueued) {
            return;
        }
        highlightQueued = true;
        requestAnimationFrame(() => {
            highlightQueued = false;
            renderHighlightedEditable(editor, editorLanguage, baseClassName);
        });
    };

    editor.addEventListener('input', queueHighlight);
    editor.addEventListener('paste', (event) => {
        event.preventDefault();
        const text = (event.clipboardData || window.clipboardData).getData('text');
        document.execCommand('insertText', false, text);
    });
    editor.addEventListener('focus', () => {
        editor.className = `${baseClassName} hljs`;
    });
    const applyEditorText = (nextSource, nextCaretOffset) => {
        editor.textContent = nextSource;
        renderHighlightedEditable(editor, editorLanguage, baseClassName);
        setCaretOffset(editor, Math.min(nextCaretOffset, nextSource.length));
    };

    editor.addEventListener('keydown', (event) => {
        const offsets = getSelectionOffsets(editor);
        if (!offsets) {
            return;
        }

        const tabText = '    ';
        const source = editor.textContent || '';
        const { start, end } = offsets;

        if (event.key === 'Enter') {
            event.preventDefault();
            const lineStart = source.lastIndexOf('\n', Math.max(0, start - 1)) + 1;
            const linePrefix = source.slice(lineStart, start);
            const baseIndentMatch = linePrefix.match(/^[ \t]*/);
            const baseIndent = baseIndentMatch ? baseIndentMatch[0] : '';
            const shouldIncreaseIndent = /:\s*(#.*)?$/.test(linePrefix.trimEnd());
            const insertText = `\n${baseIndent}${shouldIncreaseIndent ? tabText : ''}`;
            const nextSource = source.slice(0, start) + insertText + source.slice(end);
            applyEditorText(nextSource, start + insertText.length);
            return;
        }

        if (event.key !== 'Tab') {
            return;
        }

        event.preventDefault();

        if (start !== end) {
            const lineStart = source.lastIndexOf('\n', Math.max(0, start - 1)) + 1;
            const rawLineEnd = source.indexOf('\n', end);
            const lineEnd = rawLineEnd === -1 ? source.length : rawLineEnd;
            const block = source.slice(lineStart, lineEnd);
            const lines = block.split('\n');
            const transformedLines = event.shiftKey
                ? lines.map((line) => line.replace(/^ {1,4}/, ''))
                : lines.map((line) => `${tabText}${line}`);
            const nextBlock = transformedLines.join('\n');
            const nextSource = source.slice(0, lineStart) + nextBlock + source.slice(lineEnd);
            applyEditorText(nextSource, lineStart + nextBlock.length);
            return;
        }

        if (event.shiftKey) {
            const lineStart = source.lastIndexOf('\n', Math.max(0, start - 1)) + 1;
            const prefix = source.slice(lineStart, start);
            const removable = prefix.match(/ {1,4}$/);
            if (!removable) {
                return;
            }

            const removeCount = removable[0].length;
            const removeStart = start - removeCount;
            const nextSource = source.slice(0, removeStart) + source.slice(start);
            applyEditorText(nextSource, removeStart);
            return;
        }

        const nextSource = source.slice(0, start) + tabText + source.slice(end);
        applyEditorText(nextSource, start + tabText.length);
    });
    renderHighlightedEditable(editor, editorLanguage, baseClassName);

    runBtn.addEventListener('click', async () => {
        output.textContent = '';
        output.classList.remove('text-red-400');
        loadingOverlay.classList.add('active');
        status.textContent = 'Running...';
        runBtn.disabled = true;
        
        try {
            const code = editor.textContent || "";
            const result = await window.PyRuntime.run(code, {
                timeoutMs: 12000,
                useWorker: true
            });
            const combinedOutput = [result.stdout, result.stderr].filter(Boolean).join('\n');
            status.textContent = 'Done';
            if (!combinedOutput) {
                output.textContent = '(Executed successfully, no output)';
            } else {
                output.textContent = combinedOutput;
            }
        } catch (err) {
            output.classList.add('text-red-400');
            output.textContent = err.message;
            status.textContent = 'Error';
        } finally {
            loadingOverlay.classList.remove('active');
            runBtn.disabled = false;
            setTimeout(() => { 
                if (status.textContent !== 'Error') status.textContent = 'Ready'; 
            }, 2000);
        }
    });

    if (resetBtn) {
        resetBtn.addEventListener('click', () => {
             editor.textContent = originalCode;
             renderHighlightedEditable(editor, editorLanguage, baseClassName);
             output.textContent = '';
             status.textContent = 'Reset';
        });
    }
  };
})();
</script>
